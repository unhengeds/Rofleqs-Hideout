```css
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #090b10;
    --sidebar: #0d1017;
    --panel: #11151e;
    --panel2: #171c27;
    --text: #f3f5f8;
    --muted: #8d96a8;
    --accent: #6c5ce7;
    --accent2: #8b7cff;
    --border: rgba(255,255,255,.07);
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
}

.app {
    display: flex;
    min-height: 100vh;
}


/* SIDEBAR */

.sidebar {
    width: 235px;
    min-height: 100vh;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 24px 15px;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 10;
}

.logo {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0 10px 30px;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -.5px;
}

.logo-icon {
    width: 35px;
    height: 35px;
    border-radius: 10px;
    background: linear-gradient(
        135deg,
        var(--accent),
        #a18aff
    );
    display: grid;
    place-items: center;
    font-size: 18px;
    box-shadow: 0 8px 25px rgba(108,92,231,.3);
}

.nav-title {
    color: #596274;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0 12px 9px;
}

.nav {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.nav button {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 12px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    cursor: pointer;
    text-align: left;
    transition: .2s;
}

.nav button:hover {
    background: rgba(255,255,255,.05);
    color: white;
    transform: translateX(2px);
}

.nav button.active {
    background: rgba(108,92,231,.15);
    color: #fff;
}

.nav-icon {
    width: 20px;
    text-align: center;
    font-size: 16px;
}

.sidebar-bottom {
    position: absolute;
    left: 15px;
    right: 15px;
    bottom: 20px;
}

.version {
    color: #4d5564;
    font-size: 11px;
    text-align: center;
}


/* MAIN */

.main {
    margin-left: 235px;
    width: calc(100% - 235px);
    min-height: 100vh;
}


/* TOP BAR */

.topbar {
    height: 72px;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 35px;
    border-bottom: 1px solid var(--border);
    background: rgba(9,11,16,.85);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 8;
}

.search {
    position: relative;
    flex: 1;
    max-width: 500px;
}

.search input {
    width: 100%;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #121620;
    color: white;
    padding: 0 16px 0 42px;
    outline: none;
    transition: .2s;
    font-size: 14px;
}

.search input:focus {
    border-color: rgba(108,92,231,.7);
    box-shadow: 0 0 0 3px rgba(108,92,231,.1);
}

.search-icon {
    position: absolute;
    left: 15px;
    top: 12px;
    color: #737c8c;
}

.top-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
}

.top-button {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: #121620;
    color: #aab2c0;
    cursor: pointer;
    transition: .2s;
}

.top-button:hover {
    color: white;
    background: #1a1f2b;
}

.profile {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 8px;
}

.avatar {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: linear-gradient(135deg,#7060e9,#3c8df5);
    display: grid;
    place-items: center;
    font-weight: bold;
    font-size: 13px;
}


/* CONTENT */

.content {
    padding: 30px 35px 60px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 17px;
}

.section-heading h2 {
    font-size: 20px;
}

.section-heading button {
    background: none;
    border: 0;
    color: var(--accent2);
    cursor: pointer;
    font-size: 13px;
}


/* FEATURED */

.featured {
    height: 340px;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    margin-bottom: 35px;
    background:
        linear-gradient(
            90deg,
            rgba(5,7,11,.98) 0%,
            rgba(5,7,11,.82) 38%,
            rgba(5,7,11,.15) 75%,
            rgba(5,7,11,.35) 100%
        ),
        radial-gradient(
            circle at 75% 40%,
            #725ce7,
            #171a30 45%,
            #080a0f 75%
        );
    border: 1px solid var(--border);
}

.featured::after {
    content: "";
    position: absolute;
    width: 400px;
    height: 400px;
    right: 7%;
    top: -30px;
    border-radius: 50%;
    background: radial-gradient(
        circle,
        rgba(130,112,255,.35),
        transparent 65%
    );
    filter: blur(10px);
    animation: pulse 5s ease-in-out infinite;
}

@keyframes pulse {
    0%,100% {
        transform: scale(1);
        opacity: .7;
    }

    50% {
        transform: scale(1.15);
        opacity: 1;
    }
}

.featured-content {
    position: relative;
    z-index: 2;
    width: 55%;
    height: 100%;
    padding: 55px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.featured-label {
    color: #aaa0ff;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
    font-weight: bold;
}

.featured h1 {
    font-size: 43px;
    line-height: 1;
    margin-bottom: 15px;
    letter-spacing: -1.5px;
}

.featured p {
    color: #b5bdcc;
    max-width: 430px;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 24px;
}

.play-button {
    width: max-content;
    padding: 13px 24px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: white;
    font-weight: bold;
    cursor: pointer;
    transition: .2s;
    box-shadow: 0 8px 25px rgba(108,92,231,.3);
}

.play-button:hover {
    background: var(--accent2);
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(108,92,231,.4);
}


/* CATEGORIES */

.categories {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 5px;
    margin-bottom: 30px;
}

.categories::-webkit-scrollbar {
    height: 4px;
}

.categories::-webkit-scrollbar-thumb {
    background: #252b38;
    border-radius: 10px;
}

.category {
    white-space: nowrap;
    border: 1px solid var(--border);
    background: #11151e;
    color: #919aaa;
    padding: 9px 15px;
    border-radius: 8px;
    cursor: pointer;
    transition: .2s;
    font-size: 13px;
}

.category:hover {
    color: white;
    background: #181d28;
}

.category.active {
    color: white;
    background: var(--accent);
    border-color: var(--accent);
}


/* GAME GRID */

.games-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 18px;
}

.game-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition:
        transform .25s ease,
        border-color .25s ease,
        background .25s ease,
        opacity .18s ease;
}

.game-card:hover {
    transform: translateY(-6px);
    border-color: rgba(139,124,255,.4);
    background: #151a24;
}

.game-image {
    height: 165px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 14px;
}

.game-image::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(
            circle at 70% 25%,
            rgba(255,255,255,.18),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            var(--game1),
            var(--game2)
        );
    transition: transform .4s;
}

.game-card:hover .game-image::before {
    transform: scale(1.08);
}

.game-number {
    position: relative;
    z-index: 1;
    font-size: 40px;
    font-weight: 900;
    opacity: .8;
    text-shadow: 0 4px 15px rgba(0,0,0,.5);
}

.game-info {
    padding: 14px;
}

.game-title {
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 7px;
}

.game-meta {
    color: var(--muted);
    font-size: 12px;
    display: flex;
    justify-content: space-between;
}

.play-small {
    margin-top: 12px;
    width: 100%;
    border: 0;
    border-radius: 7px;
    background: #202635;
    color: white;
    padding: 9px;
    cursor: pointer;
    font-weight: bold;
    transition: .2s;
}

.play-small:hover {
    background: var(--accent);
}


/* NO RESULTS */

.no-results {
    display: none;
    text-align: center;
    padding: 50px;
    color: var(--muted);
}

.no-results h3 {
    color: white;
    margin-bottom: 7px;
}


/* RESPONSIVE */

@media (max-width: 1050px) {

    .games-grid {
        grid-template-columns:
            repeat(3,minmax(0,1fr));
    }

}

@media (max-width: 800px) {

    .sidebar {
        width: 70px;
        padding: 18px 10px;
    }

    .logo {
        justify-content: center;
        padding: 0 0 25px;
    }

    .logo-text,
    .nav-title,
    .nav button span,
    .version {
        display: none;
    }

    .nav button {
        justify-content: center;
        padding: 13px 5px;
    }

    .sidebar-bottom {
        display: none;
    }

    .main {
        margin-left: 70px;
        width: calc(100% - 70px);
    }

    .topbar {
        padding: 0 20px;
    }

    .content {
        padding: 25px 20px 50px;
    }

    .games-grid {
        grid-template-columns:
            repeat(2,minmax(0,1fr));
    }

    .featured-content {
        width: 75%;
        padding: 35px;
    }

    .featured h1 {
        font-size: 34px;
    }
}

@media (max-width: 560px) {

    .profile {
        display: none;
    }

    .topbar {
        gap: 8px;
    }

    .top-button {
        display: none;
    }

    .featured {
        height: 370px;
    }

    .featured-content {
        width: 100%;
        padding: 28px;
        justify-content: flex-end;
        background:
            linear-gradient(
                transparent,
                rgba(5,7,11,.95)
            );
    }

    .featured h1 {
        font-size: 30px;
    }

    .games-grid {
        grid-template-columns: 1fr;
    }

    .game-image {
        height: 190px;
    }
}
```
